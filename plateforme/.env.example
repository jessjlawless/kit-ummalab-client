# Copie ce fichier en .env (setup.sh le fait pour toi) puis remplis ce que tu as. Rien n'est obligatoire :
# avec Claude Code connecté (ton abonnement), la génération marche déjà sans aucune clé. Détails : GUIDE.md.

# --- LLM : laisser VIDE pour utiliser Claude Code (ton abonnement Claude). Clé API = facturation à l'usage. ---
ANTHROPIC_API_KEY=
# Optionnel : modèle (défaut dans config/engine.yaml)
# CLAUDE_MODEL=claude-sonnet-5-5
# Optionnel : forcer l'URL de l'API (laisser vide = https://api.anthropic.com)
ENGINE_ANTHROPIC_BASE_URL=

# --- Transcription (Whisper API). Sinon : pip install faster-whisper (local) ---
OPENAI_API_KEY=

# --- Scraping ---
# Recommandé : Apify (fiable, payant à l'usage ~quelques $/mois à ce volume)
APIFY_TOKEN=
# Alternative Instagram : session instaloader (compte secondaire !). Voir GUIDE.md
IG_SCRAPER_USERNAME=
# Alternative TikTok : cookies du navigateur pour yt-dlp (chrome, safari, firefox...)
YTDLP_COOKIES_BROWSER=

# --- Instagram Graph API (stats de TES vidéos, module 6) ---
# Ton app Meta : remplis ces 3 lignes puis lance `./bin/engine ig-auth` → les lignes IG_<COMPTE>_* se remplissent seules.
IG_APP_ID=
IG_APP_SECRET=
# Doit être déclarée À L'IDENTIQUE dans l'app Meta (Instagram Login : https obligatoire)
IG_REDIRECT_URI=https://localhost:8765/callback
# Rempli automatiquement par `engine ig-auth` (ou le bouton du dashboard)
IG_PERSONAL_USER_ID=
IG_PERSONAL_TOKEN=
# graph.facebook.com (login Facebook) ou graph.instagram.com (Instagram Login)
IG_GRAPH_HOST=graph.instagram.com
IG_GRAPH_VERSION=v23.0
